    "typescript": "^3.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.5",
    "@types/cookie-parser": "^1.4.1",
    "@types/ejs": "^3.1.5",
    "@types/express": "4.16.1",
    "@types/helmet": "0.0.48",
    "@types/jsonwebtoken": "^8.3.0",
