# HTTP — Railway sets PORT automatically
PORT=3050

# Public OAuth issuer = API gateway (browser + Cursor)
MCP_ISSUER=http://127.0.0.1:8088

# MCP resource URL (must include /mcp for RFC 9728)
MCP_RESOURCE_URL=http://127.0.0.1:8088/mcp

# Leni web app — login page for OAuth
APP_URL=http://localhost:3000

# Backend API — host dev: gateway on 8088; Docker: http://api-gateway:8080
API_GATEWAY=http://127.0.0.1:8088

# Auth (copy from sr-services / auth-service)
MCP_JWT_SECRET=replace_with_long_random_string
JWT_ACCESS_SECRET=same_as_auth_service_sr_access_secret

# Cube analytics
CUBE_API_TOKEN=
CUBE_API_BASE_ENDPOINT=

# CORS (Claude, MCP Inspector, local app)
MCP_ALLOWED_ORIGINS=https://claude.ai,https://www.claude.ai,http://localhost:6274,http://127.0.0.1:6274,http://localhost:3000

# Dev only — never in production
# LOCAL_OAUTH_BYPASS=true
