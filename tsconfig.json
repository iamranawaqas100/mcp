{
  "compilerOptions": {
    "sourceMap": true,
    "target": "ES2022",
    "module": "commonjs",
    "esModuleInterop": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "outDir": "./dist",
    "baseUrl": "./src",
    "alwaysStrict": true,
    "noImplicitAny": true,
    "experimentalDecorators": true,
    "moduleResolution": "node10",
    "resolveJsonModule": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
